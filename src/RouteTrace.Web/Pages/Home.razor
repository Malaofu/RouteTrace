@page "/"

@using RouteTrace.Web.Features.Map
@using RouteTrace.Web.Features.Import
@using RouteTrace.Web.Features.Workspaces
@using RouteTrace.Web.Features.Commands

<PageTitle>Route Trace</PageTitle>

<h1 class="visually-hidden">Route Trace map</h1>
<div class="home-workspace">
    <section class="home-workspace__map" aria-label="Map workspace">
        <MapViewport Documents="MapDocuments" Selection="selection" FocusVersion="focusVersion" />
        <ApplicationMenu ActiveDocument="workspace.ActiveDocument"
                         InspectorVisible="inspectorVisible"
                         ExplorerVisible="explorerVisible"
                         DocumentImported="HandleDocumentImported"
                         InspectorVisibilityChanged="HandleInspectorVisibilityChanged"
                         ExplorerVisibilityChanged="HandleExplorerVisibilityChanged" />
        <WorkspacePanel Workspace="workspace" WorkspaceChanged="HandleWorkspaceChangedAsync" WorkspaceDeleted="HandleWorkspaceDeleted" />
        @if (workspace.ActiveDocument is not null && inspectorVisible)
        {
            <GpxInspector Document="workspace.ActiveDocument.Document" SelectionChanged="HandleSelectionChanged" />
        }
    </section>
    <DocumentExplorer Workspace="workspace"
                      Selection="selection"
                      Visible="explorerVisible"
                      WorkspaceChanged="HandleWorkspaceChangedAsync"
                      SelectionChanged="HandleSelectionChanged"
                      FocusRequested="HandleFocusRequested" />
</div>
