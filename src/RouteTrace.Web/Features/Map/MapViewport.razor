@implements IAsyncDisposable

<div class="map-viewport-shell">
    <div id="@elementId"
         class="map-viewport"
         role="application"
         aria-label="Interactive route map"
         data-visible-documents="@Documents.Count"
         data-selected-track="@Selection.TrackIndex"
         data-selected-segment="@Selection.SegmentIndex"
         data-selected-route="@Selection.RouteIndex"
         data-selected-waypoint="@Selection.WaypointIndex"
         data-editing="@(EditingEnabled ? "true" : "false")"
         data-editing-points="@EditingAnchors.Count"
         data-selected-editing-point="@SelectedEditingPoint"
         data-selected-document="@(Selection.WholeDocument ? "true" : "false")"
         data-selected-waypoint-group="@(Selection.WaypointGroup ? "true" : "false")">
    </div>
    @if (hoveredWaypoint is not null)
    {
        <aside class="map-poi-tooltip" role="tooltip" style="left: @(hoveredWaypoint.Left)px; top: @(hoveredWaypoint.Top)px; --map-poi-pin-height: @(HoveredPinHeight())px">
            <strong class="map-poi-tooltip__title">@(hoveredWaypoint.Waypoint.Name ?? "Point of interest")</strong>
            <span class="map-poi-tooltip__metadata">@WaypointMetadata(hoveredWaypoint.Waypoint)</span>
            @if (!string.IsNullOrWhiteSpace(hoveredWaypoint.Waypoint.Description))
            {
                <span class="map-poi-tooltip__description">@hoveredWaypoint.Waypoint.Description</span>
            }
        </aside>
    }
    @if (editingPointMenu is not null)
    {
        <div class="map-editing-point-menu"
             role="menu"
             aria-label="Editing anchor actions"
             style="left: @(editingPointMenu.Left)px; top: @(editingPointMenu.Top)px">
            <button type="button" role="menuitem" @onclick="DeleteEditingPointFromMenuAsync">Delete anchor</button>
        </div>
    }
</div>
@if (Documents.Count > 0 && Documents.All(document => document.Geometry.Tracks.Count == 0 && document.Geometry.Routes.Count == 0 && document.Geometry.Waypoints.Count == 0))
{
    <div class="map-viewport__empty" role="status">This GPX document contains no mappable content.</div>
}
