@using RouteTrace.Core.Routes
@inject IWorkspaceStore Store
@inject IJSRuntime JavaScript

<section class="workspace-panel" aria-labelledby="workspace-title">
    <h2 id="workspace-title">Workspace</h2>
    <label>
        Name
        <input value="@workspaceName" @onchange="RenameAsync" disabled="@isBusy" />
    </label>
    <p>Changes are saved automatically in this browser.</p>

    @if (Workspace.Documents.Count > 0)
    {
        <label>
            Active document
            <select value="@Workspace.ActiveDocumentId" @onchange="ActivateDocumentAsync">
                @foreach (WorkspaceDocument document in Workspace.Documents)
                {
                    <option value="@document.Id">@(document.Document.Metadata?.Name ?? document.SourceFileName ?? "Unnamed document")</option>
                }
            </select>
        </label>
        <ul class="workspace-panel__documents" aria-label="Open documents">
            @foreach (WorkspaceDocument document in Workspace.Documents)
            {
                <li class="@(document.Id == Workspace.SelectedDocumentId ? "workspace-panel__document--selected" : null)">
                    <input type="checkbox"
                           aria-label="Show @(DocumentName(document))"
                           checked="@document.IsVisible"
                           @onchange="eventArgs => SetVisibilityAsync(document.Id, eventArgs)" />
                    <span style="--document-colour: @document.Colour">@DocumentName(document)</span>
                    <button type="button" @onclick="() => SelectAsync(document.Id)">Select</button>
                    <button type="button" @onclick="() => CloseAsync(document.Id)">Close</button>
                </li>
            }
        </ul>
    }

    <h3>Saved workspaces</h3>
    @if (savedWorkspaces.Count == 0)
    {
        <p>No saved workspaces.</p>
    }
    else
    {
        <ul>
            @foreach (SavedWorkspaceSummary saved in savedWorkspaces)
            {
                <li>
                    <span>@saved.Name</span>
                    <button type="button" @onclick="() => OpenAsync(saved.Id)" disabled="@isBusy">Open</button>
                    <button type="button" @onclick="() => DeleteAsync(saved)" disabled="@isBusy">Delete</button>
                </li>
            }
        </ul>
    }

    @if (message is not null)
    {
        <p role="status">@message</p>
    }
    @if (error is not null)
    {
        <p role="alert">@error</p>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public required RouteWorkspace Workspace { get; set; }

    [Parameter]
    public EventCallback<RouteWorkspace> WorkspaceChanged { get; set; }

    [Parameter]
    public EventCallback<Guid> WorkspaceDeleted { get; set; }

    private IReadOnlyList<SavedWorkspaceSummary> savedWorkspaces = [];
    private string workspaceName = string.Empty;
    private string? message;
    private string? error;
    private bool isBusy;

    protected override async Task OnInitializedAsync()
    {
        workspaceName = Workspace.Name;
        await RefreshAsync();
    }

    protected override void OnParametersSet()
    {
        if (workspaceName != Workspace.Name && !isBusy) workspaceName = Workspace.Name;
    }

    private async Task RenameAsync(ChangeEventArgs eventArgs)
    {
        string newName = eventArgs.Value?.ToString() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(newName))
        {
            error = "The workspace name cannot be empty.";
            return;
        }

        workspaceName = newName.Trim();
        await WorkspaceChanged.InvokeAsync(Workspace.Rename(workspaceName));
        await RefreshAsync();
        message = $"Renamed to {workspaceName}.";
    }

    private async Task OpenAsync(Guid id)
    {
        await RunAsync(async () =>
        {
            WorkspaceDecodeResult result = await Store.OpenAsync(id);
            if (!result.IsSuccess)
            {
                error = result.Error;
                return;
            }
            workspaceName = result.Workspace!.Name;
            await WorkspaceChanged.InvokeAsync(result.Workspace);
            message = $"Opened {result.Workspace.Name}.";
        });
    }

    private async Task DeleteAsync(SavedWorkspaceSummary saved)
    {
        bool confirmed = await JavaScript.InvokeAsync<bool>("confirm", $"Delete the saved workspace '{saved.Name}'?");
        if (!confirmed) return;

        await RunAsync(async () =>
        {
            await Store.DeleteAsync(saved.Id);
            await WorkspaceDeleted.InvokeAsync(saved.Id);
            await RefreshAsync();
            message = $"Deleted {saved.Name}.";
        });
    }

    private async Task ActivateDocumentAsync(ChangeEventArgs eventArgs)
    {
        if (Guid.TryParse(eventArgs.Value?.ToString(), out Guid documentId))
            await WorkspaceChanged.InvokeAsync(Workspace.Activate(documentId));
    }

    private Task SelectAsync(Guid documentId) => WorkspaceChanged.InvokeAsync(Workspace.Select(documentId));

    private Task CloseAsync(Guid documentId) => WorkspaceChanged.InvokeAsync(Workspace.Close(documentId));

    private Task SetVisibilityAsync(Guid documentId, ChangeEventArgs eventArgs) =>
        WorkspaceChanged.InvokeAsync(Workspace.SetVisibility(documentId, eventArgs.Value is true));

    private static string DocumentName(WorkspaceDocument document) =>
        document.Document.Metadata?.Name ?? document.SourceFileName ?? "Unnamed document";

    private async Task RefreshAsync() => savedWorkspaces = await Store.ListAsync();

    private async Task RunAsync(Func<Task> action)
    {
        isBusy = true;
        error = null;
        message = null;
        try
        {
            await action();
        }
        catch (JSException)
        {
            error = "Browser storage is unavailable.";
        }
        finally
        {
            isBusy = false;
        }
    }
}
