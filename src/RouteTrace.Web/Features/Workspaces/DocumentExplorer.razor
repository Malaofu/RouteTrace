<aside class="document-explorer @(Visible ? null : "document-explorer--hidden")"
       aria-label="Document explorer"
       aria-hidden="@(!Visible)"
       @oncontextmenu="OpenBackgroundActions"
       @oncontextmenu:preventDefault>
    <header><h2>Documents</h2></header>
    <DocumentTree @ref="tree"
                  Workspace="Workspace"
                  SelectedNodes="selectedNodes"
                  SelectionRequested="SelectTargetAsync"
                  ActionsRequested="OpenActionsAsync" />
</aside>

<DocumentExplorerActions @ref="actions"
                         Workspace="Workspace"
                         WorkspaceChanged="WorkspaceChanged"
                         FocusRequested="FocusRequested"
                         EditRequested="EditRequested"
                         TrackExpansionRequested="ExpandTrack" />
