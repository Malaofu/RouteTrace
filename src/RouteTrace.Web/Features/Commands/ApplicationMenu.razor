@implements IAsyncDisposable

<div class="application-menu" @onkeydown="HandleMenuKeyDown">
    <button @ref="menuButton"
            type="button"
            class="application-menu__trigger"
            aria-haspopup="menu"
            aria-expanded="@(activeMenu == "file" ? "true" : "false")"
            aria-controls="file-menu"
            @onclick="ToggleFileMenu">
        File
    </button>
    <button @ref="viewMenuButton"
            type="button"
            class="application-menu__trigger"
            aria-haspopup="menu"
            aria-expanded="@(activeMenu == "view" ? "true" : "false")"
            aria-controls="view-menu"
            @onclick="ToggleViewMenu">
        View
    </button>

    @if (activeMenu == "file")
    {
        <div id="file-menu" class="application-menu__popup" role="menu" aria-label="File">
            <button @ref="openButton" type="button" role="menuitem" disabled="@(!openCommand.CanExecute)" @onclick="OpenFilePickerAsync">
                <span class="application-menu__icon" aria-hidden="true">▱</span>
                <span>Open GPX…</span>
                <kbd>Ctrl+O</kbd>
            </button>
            <button @ref="saveButton" type="button" role="menuitem" disabled="@(!exportCommand.CanExecute)" @onclick="ExportFromMenuAsync">
                <span class="application-menu__icon" aria-hidden="true">↓</span>
                <span>Download GPX</span>
                <kbd>Ctrl+S</kbd>
            </button>
        </div>
    }
    else if (activeMenu == "view")
    {
        <div id="view-menu" class="application-menu__popup" role="menu" aria-label="View">
            <button @ref="explorerButton" type="button" role="menuitemcheckbox" aria-checked="@(ExplorerVisible ? "true" : "false")" @onclick="ToggleExplorerAsync">
                <span class="application-menu__icon" aria-hidden="true">@(ExplorerVisible ? "✓" : "")</span>
                <span>Explorer</span>
                <kbd>Ctrl+E</kbd>
            </button>
            <button @ref="inspectorButton" type="button" role="menuitemcheckbox" aria-checked="@(InspectorVisible ? "true" : "false")" @onclick="ToggleInspectorAsync">
                <span class="application-menu__icon" aria-hidden="true">@(InspectorVisible ? "✓" : "")</span>
                <span>Inspector</span>
                <kbd>Ctrl+I</kbd>
            </button>
        </div>
    }

    <span class="application-menu__file-input" aria-hidden="true">
        <InputFile @ref="fileInput"
                   tabindex="-1"
                   OnChange="ImportAsync"
                   accept=".gpx,application/gpx+xml,application/xml,text/xml" />
    </span>
</div>

@if (dropTargetVisible)
{
    <div class="application-menu__drop-target" role="status" aria-live="polite">
        <div>
            <strong>Drop GPX to import</strong>
            <span>Processed locally in this browser.</span>
        </div>
    </div>
}

@if (isImporting)
{
    <p role="status" class="application-menu__notice">Reading and processing locally…</p>
}
else if (message is not null)
{
    <p role="@(hasError ? "alert" : "status")" class="application-menu__notice @(hasError ? "application-menu__notice--error" : null)">@message</p>
}
